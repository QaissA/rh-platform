# Development image for an RH platform Rails service.
FROM ruby:3.4

# libpq-dev is required to build the pg gem's native extension.
RUN apt-get update -qq && apt-get install -y --no-install-recommends libpq-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./
# The lock file is generated on the host (Windows); add the Linux platform.
RUN bundle lock --add-platform x86_64-linux && bundle install

COPY . .

EXPOSE 3000

# Prepare the database (create + migrate + seed) then boot the server.
# Use `bundle exec` rather than bin/rails: the host-generated binstubs carry a
# Windows `ruby.exe` shebang that does not exist in this Linux image.
CMD ["bash", "-c", "bundle exec rails db:prepare && bundle exec rails server -b 0.0.0.0 -p 3000"]
